{
  "title": "Windows: звук, окна, экран",
  "platform": "win32",
  "macros": [
    {
      "id": "mute",
      "phrases": ["выключи звук", "отключи звук", "беззвучный режим", "режим без звука", "убери звук"],
      "do": { "type": "volume", "mute": "on" }
    },
    {
      "id": "unmute",
      "phrases": ["включи звук", "верни звук", "режим со звуком"],
      "do": { "type": "volume", "mute": "off" }
    },
    {
      "id": "volume-set",
      "phrases": ["громкость {number}", "громкость на {number}", "поставь громкость {number}", "поставь громкость на {number}",
        "установи громкость на {number}", "сделай громкость {number}", "звук на {number}", "поставь звук на {number}"],
      "do": { "type": "volume", "set": "${number}" },
      "notify": "Громкость ${result}%"
    },
    {
      "id": "volume-max",
      "phrases": ["громкость на максимум", "звук на максимум", "полная громкость", "максимальная громкость"],
      "do": { "type": "volume", "set": 100 },
      "notify": "Громкость ${result}%"
    },
    {
      "id": "volume-mid",
      "phrases": ["громкость на середину", "средняя громкость", "звук на середину"],
      "do": { "type": "volume", "set": 50 },
      "notify": "Громкость ${result}%"
    },
    {
      "id": "volume-min",
      "phrases": ["громкость на минимум", "звук на минимум", "минимальная громкость"],
      "do": { "type": "volume", "set": 15 },
      "notify": "Громкость ${result}%"
    },
    {
      "id": "louder",
      "phrases": ["погромче", "сделай погромче", "сделай громче", "прибавь звук", "прибавь громкость", "добавь звук"],
      "do": { "type": "volume", "delta": 15 },
      "notify": "Громкость ${result}%"
    },
    {
      "id": "quieter",
      "phrases": ["потише", "сделай потише", "сделай тише", "убавь звук", "убавь громкость"],
      "do": { "type": "volume", "delta": -15 },
      "notify": "Громкость ${result}%"
    },
    {
      "id": "media-toggle",
      "phrases": ["пауза", "поставь на паузу", "продолжи воспроизведение", "продолжи музыку", "включи музыку", "сними с паузы"],
      "do": { "type": "media", "action": "play" }
    },
    {
      "id": "media-stop",
      "phrases": ["выключи музыку", "останови музыку", "стоп музыка"],
      "do": { "type": "media", "action": "stop" }
    },
    {
      "id": "media-next",
      "phrases": ["следующий трек", "следующая песня", "переключи трек", "переключи песню", "дальше трек"],
      "do": { "type": "media", "action": "next" }
    },
    {
      "id": "media-prev",
      "phrases": ["предыдущий трек", "предыдущая песня", "верни трек", "верни прошлый трек"],
      "do": { "type": "media", "action": "prev" }
    },
    {
      "id": "minimize-all",
      "phrases": ["сверни все окна", "сверни окна", "сверни окно", "покажи рабочий стол"],
      "do": { "type": "system", "action": "minimize-all" }
    },
    {
      "id": "screenshot",
      "phrases": ["сделай скриншот", "сделай скриншот экрана", "сделай снимок экрана", "сними экран", "скриншот"],
      "do": { "type": "system", "action": "screenshot" },
      "sound": "done",
      "notify": "Скриншот сохранён: ${result}"
    },
    {
      "id": "empty-trash",
      "phrases": ["очисти корзину", "почисти корзину", "очистка корзины"],
      "do": { "type": "system", "action": "empty-trash" }
    },
    {
      "id": "lock",
      "phrases": ["заблокируй компьютер", "заблокируй комп", "заблокируй экран", "блокировка компьютера"],
      "do": { "type": "system", "action": "lock" },
      "threshold": 85
    },
    {
      "id": "sleep",
      "phrases": ["спящий режим", "режим сна", "включи спящий режим", "переведи компьютер в спящий режим", "усыпи компьютер"],
      "do": [{ "type": "wait", "ms": 1500 }, { "type": "system", "action": "sleep" }],
      "threshold": 88
    },
    {
      "id": "clipboard",
      "phrases": ["открой буфер обмена", "покажи буфер обмена", "буфер обмена"],
      "do": { "type": "keys", "keys": "Win+V" }
    },
    {
      "id": "layout",
      "phrases": ["смени раскладку", "поменяй раскладку", "смени язык", "поменяй язык", "переключи раскладку", "переключи язык"],
      "do": { "type": "keys", "keys": "Alt+Shift" }
    },
    {
      "id": "task-manager",
      "phrases": ["открой диспетчер задач", "запусти диспетчер задач", "диспетчер задач"],
      "do": { "type": "open", "target": "taskmgr" }
    }
  ]
}
